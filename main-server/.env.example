# ---- Required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram user IDs allowed to use the bot + dashboard (comma separated).
# Don't know yours? Start the server, send /start to the bot, it replies with your ID.
ADMIN_IDS=111111111

# ---- URLs -----------------------------------------------------------------
# Public HTTPS address of this main server. Sub servers send their reports here,
# and it goes into the .env snippet the bot gives you for each sub server.
PUBLIC_URL=https://watchdog.example.com
# The dashboard (Telegram Mini App). Telegram only opens Mini Apps over HTTPS.
WEBAPP_URL=https://watchdog.example.com/app/

# ---- Optional -------------------------------------------------------------
# Extra chats (e.g. a group, IDs start with -100) that also receive alerts
ALERT_CHAT_IDS=
HOST=0.0.0.0
PORT=8080
DATA_FILE=data/watchdog.json

# A sub server is "down" after this many seconds without a report
OFFLINE_AFTER_SECONDS=30
# Live history kept for the dashboard charts
HISTORY_MINUTES=60
# Regular health report to Telegram, in minutes (0 = off)
HEALTH_REPORT_INTERVAL_MINUTES=360

# Alert thresholds (0 disables a rule) and how long they must hold
CPU_ALERT_PERCENT=90
CPU_ALERT_FOR_SECONDS=120
RAM_ALERT_PERCENT=90
RAM_ALERT_FOR_SECONDS=120
DISK_ALERT_PERCENT=90
DISK_ALERT_FOR_SECONDS=0
TEMP_ALERT_CELSIUS=80
TEMP_ALERT_FOR_SECONDS=60
# An alert clears only after dropping this far below the threshold
ALERT_HYSTERESIS=5

# Local testing only: open http://localhost:8080/app/ in a normal browser without Telegram login
DEV_NO_AUTH=false
