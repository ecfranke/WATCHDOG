[Unit]
Description=Watchdog main server (Telegram bot + dashboard)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/watchdog/main-server
ExecStart=/usr/bin/node /opt/watchdog/main-server/src/index.js
Restart=always
# (Restart=always is also how a downloaded update gets applied)
RestartSec=5
User=watchdog
Group=watchdog
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
