# Paste the two lines the main server gave you (Telegram: /add <name>, or Dashboard → Add server)
MAIN_SERVER_URL=https://watchdog.example.com
AGENT_TOKEN=wd_paste_your_token_here

# Optional: seconds between reports (default 5)
INTERVAL_SECONDS=5

# Auto-update from GitHub (works when installed from a git clone, see install.sh)
AUTO_UPDATE=true
UPDATE_CHECK_MINUTES=30
# Branch to follow (default: the one that is checked out)
UPDATE_BRANCH=
# Only for a private repository: a fine-grained GitHub token with read-only "Contents" access
UPDATE_GITHUB_TOKEN=
